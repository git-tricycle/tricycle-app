{
  "expo": {
    "name": "Ride It! Tricycle Booking App",
    "slug": "tricycle",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/tric.jpg",
    "scheme": "tricycle",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tricycle.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "This app uses location to show your current position on the map for ride booking.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "This app uses location to show your current position on the map for ride booking."
      }
    },
    "android": {
      "package": "com.tricycle.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/tric.jpg",
        "backgroundImage": "./assets/images/tric.jpg",
        "monochromeImage": "./assets/images/tric.jpg"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/tric.jpg",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow this app to use location to show your current position on the map for ride booking."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/tric.jpg",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "3c1d0061-db56-441f-89a9-db36998d87d0"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/3c1d0061-db56-441f-89a9-db36998d87d0"
    }
  }
}
